<tr class="border-b border-border cursor-pointer group">
    @each(title in [repo, "Other Info", "Public"])
        <td
            class="_repo-item transition-colors group-hover:bg-page-hover py-2 px-3 {{ loop.first ? '' : 'w-40' }}"
            data-url="/tags/{{ repo }}"
        >
            <a href="/tags/{{ repo }}">{{ title }}</a>
        </td>
    @end
</tr>