@use('~main')

@insert('title', 'Tags of ' + name)

@insert('content')
    <h1 class="text-2xl">Tags of {{ name }}</h1>

    @component('~table/table', { titles: ["Name", "Arch"] })
        @each(tag in tags)
            @component('~table/row', {
                cols: [tag.Name, tag.Arch],
            })@end
        @end
    @end
@end