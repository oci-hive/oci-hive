@use('~main')

@insert('title', 'Tags of ' + name)

@insert('content')
    <h1 class="text-2xl">Tags of {{ name }}</h1>

    <table class="mt-5 table-auto w-full">
        <thead>
            <tr class="border-b border-border">
                @each(title in ['Name', 'Size', 'Arch'])
                    <td class="py-2 px-3 {{ loop.first ? '' : 'w-40' }}">
                        {{ title }}
                    </td>
                @end
            </tr>
        </thead>
        <tbody>
            @each(tag in tags)
                <tr class="border-b border-border">
                    {{ tdClass = 'py-2 px-3' }}

                    <td class="{{ tdClass }}">
                        {{ tag.Name }}
                    </td>

                    <td class="{{ tdClass }}">
                        23
                    </td>

                    <td class="{{ tdClass }} w-40 flex flex-col gap-1">
                        @each(arch in tag.Arch)
                            <div class="bg-secondary inline-block text-center rounded-full px-3 py-0.5">
                                {{ arch }}
                            </div>
                        @end
                    </td>
                </tr>
            @end
        </tbody>
    </table>
@end