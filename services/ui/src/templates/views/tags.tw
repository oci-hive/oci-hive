@use('~main')

@insert('title', 'Tags of ' + name)

@insert('content')
    <h1 class="text-2xl">Tags of {{ name }}</h1>

    {{ tdClass = 'py-2 px-3' }}
    {{ sizeClass = '%s w-28'.format(tdClass) }}
    {{ archClass = '%s w-40'.format(tdClass) }}

    <table class="mt-5 table-auto w-full">
        <thead>
            <tr class="border-b border-border">
                <td class="{{ tdClass }}">Name</td>
                <td class="{{ sizeClass }}">Size</td>
                <td class="{{ archClass }}">Arch</td>
            </tr>
        </thead>
        <tbody>
            @each(tag in tags)
                <tr class="border-b border-border">
                    <td class="{{ tdClass }}">{{ tag.Name }}</td>
                    <td class="{{ sizeClass }}">{{ tag.Size }}</td>
                    <td class="{{ archClass }} flex flex-col gap-1">
                        @each(arch in tag.Arch)
                            <div class="bg-secondary inline-block text-center rounded-full px-3 py-0.5">
                                {{ arch }}
                            </div>
                        @end
                    </td>
                </tr>
            @end
        </tbody>
    </table>
@end