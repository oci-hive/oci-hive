@use('~main')

@insert('title', title)

@insert('content')
    <h1 class="text-2xl">{{ repos.len() }} repositories</h1>

    @component('~table/table', { titles: ["Name", "Visibility"] })
        @each(repo in repos)
            @component('~table/row', {
                cols: [repo, 'Public'],
                url: '/tags/%s'.format(repo),
                trClass: '_repo-item',
            })@end
        @end
    @end
@end